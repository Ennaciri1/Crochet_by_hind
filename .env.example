# ---------------------------------------------------------------
# Copy this file to ".env.local" and fill in your own values.
# All these variables are PUBLIC (NEXT_PUBLIC_...): never put a
# secret key here. Security comes from Row Level Security in Supabase.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=My Crochet Blog
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_ETSY_SHOP_URL=https://www.etsy.com/shop/YourShop
NEXT_PUBLIC_PINTEREST_URL=https://www.pinterest.com/yourname

# Google AdSense (leave empty until your site is approved)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=

# Server-only. Used by "npm run import:posts". Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Brevo — the mailing list (optional).
# Leave empty and sign-ups are still saved in Supabase; you just
# export them by hand from /admin/subscribers.
#
# SERVER-ONLY: never add a NEXT_PUBLIC_ prefix to the API key, or it
# would be sent to every visitor's browser.
# ---------------------------------------------------------------

# Brevo → the account menu (top right) → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=

# Brevo → Contacts → Lists. The number shown in the list's URL/ID column.
BREVO_LIST_ID=

# Only if your Brevo account calls the first name something other than
# FIRSTNAME (some older accounts use FNAME). Leave empty otherwise.
BREVO_NAME_ATTRIBUTE=
